# ==============================================================================
# AI Sales Agent - Local & Production Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your secret credentials:
#   Copy-Item .env.example .env   (PowerShell)
#   cp .env.example .env          (Linux/Bash)
#
# NEVER commit the active .env file to Git!
# ==============================================================================

# Container Image Tags (Pinned stable, ARM64 & AMD64 compatible)
N8N_IMAGE_TAG=2.44.6
POSTGRES_IMAGE_TAG=16-alpine

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
POSTGRES_DB=n8n_sales_agent
POSTGRES_USER=n8n_db_user
# Use a strong, random password (e.g., generated with: openssl rand -hex 16)
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# ==============================================================================
# n8n Database Connection
# ==============================================================================
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_sales_agent
DB_POSTGRESDB_USER=n8n_db_user
DB_POSTGRESDB_PASSWORD=replace_with_secure_postgres_password

# ==============================================================================
# n8n Core & Security Settings
# ==============================================================================
# Local port mapping: bound strictly to localhost (127.0.0.1)
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
# Updated dynamically by scripts/start-tunnel.ps1 to the active Cloudflare Tunnel URL
WEBHOOK_URL=http://127.0.0.1:5678/

# 32+ character hexadecimal string to encrypt credentials stored in n8n.
# DO NOT LOSE THIS KEY! If changed, encrypted credentials cannot be recovered.
# Generate with PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# Generate with Linux/Mac:   openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key

# ==============================================================================
# Localization & Timezone
# ==============================================================================
# Manila business timezone (UTC+8)
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# ==============================================================================
# Execution Retention & Database Pruning Settings
# ==============================================================================
# Prevent SQLite/PostgreSQL bloat by pruning old execution records
EXECUTIONS_DATA_PRUNE=true
# Max age in hours before executions are pruned (168h = 7 days)
EXECUTIONS_DATA_MAX_AGE=168
# Maximum count of executions to keep in the database
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
# Save execution history
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# ==============================================================================
# External Service Integrations
# ==============================================================================
# Gemini 2.0 Flash / Flash-Lite API Key (Obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Phase 4: Telegram Business Bot Configuration
# ==============================================================================
# Telegram Business Bot Token (Obtained from @BotFather for the Connected Business Bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Random secret string sent in X-Telegram-Bot-Api-Secret-Token to verify webhook requests
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret_token

# Seller's Telegram User ID (used to filter out outgoing messages typed by the seller)
TELEGRAM_SELLER_USER_ID=your_seller_numeric_user_id

# Safety switch: must be explicitly 'true' to send any automated replies
TELEGRAM_TEST_MODE=false

# Comma-separated list of Telegram Chat IDs permitted to receive automated test responses
# Example: 123456789,987654321
TELEGRAM_ALLOWED_TEST_CHAT_IDS=
