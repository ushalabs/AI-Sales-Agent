{
  "name": "Phase 4 - Telegram Business Sales Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-business",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000001",
      "name": "Telegram Webhook Receiver",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "telegram-business-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "sec-check-1",
              "leftValue": "={{ $env.TELEGRAM_WEBHOOK_SECRET ? ($json.headers['x-telegram-bot-api-secret-token'] === $env.TELEGRAM_WEBHOOK_SECRET) : true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000002",
      "name": "Verify Secret Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "rule-bm",
                    "leftValue": "={{ $json.body.business_message !== undefined }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "rule-bc",
                    "leftValue": "={{ $json.body.business_connection !== undefined }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "rule-m",
                    "leftValue": "={{ $json.body.message !== undefined }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000003",
      "name": "Route Inbound Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [640, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "norm-1",
              "name": "update_id",
              "value": "={{ $json.body.update_id }}",
              "type": "number"
            },
            {
              "id": "norm-2",
              "name": "business_connection_id",
              "value": "={{ $json.body.business_message.business_connection_id || '' }}",
              "type": "string"
            },
            {
              "id": "norm-3",
              "name": "chat_id",
              "value": "={{ $json.body.business_message.chat.id }}",
              "type": "number"
            },
            {
              "id": "norm-4",
              "name": "sender_id",
              "value": "={{ $json.body.business_message.from.id }}",
              "type": "number"
            },
            {
              "id": "norm-5",
              "name": "sender_name",
              "value": "={{ $json.body.business_message.from.first_name || '' }}",
              "type": "string"
            },
            {
              "id": "norm-6",
              "name": "is_bot",
              "value": "={{ $json.body.business_message.from.is_bot || false }}",
              "type": "boolean"
            },
            {
              "id": "norm-7",
              "name": "message_id",
              "value": "={{ $json.body.business_message.message_id }}",
              "type": "number"
            },
            {
              "id": "norm-8",
              "name": "text",
              "value": "={{ $json.body.business_message.text || '' }}",
              "type": "string"
            },
            {
              "id": "norm-9",
              "name": "timestamp",
              "value": "={{ $json.body.business_message.date }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000004",
      "name": "Normalize Business Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT is_enabled FROM agent_control_state WHERE id = 1;\nSELECT is_paused FROM chat_conversation_state WHERE chat_id = {{ $json.chat_id }};",
        "options": {}
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000005",
      "name": "Check Agent State & Pauses",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1120, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-sales-agent",
          "name": "PostgreSQL Sales Agent"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "gate-has-text",
              "leftValue": "={{ $('Normalize Business Message').item.json.text && $('Normalize Business Message').item.json.text.trim().length > 0 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            },
            {
              "id": "gate-not-seller",
              "leftValue": "={{ String($('Normalize Business Message').item.json.sender_id) !== String($env.TELEGRAM_SELLER_USER_ID) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            },
            {
              "id": "gate-not-bot",
              "leftValue": "={{ $('Normalize Business Message').item.json.is_bot !== true }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            },
            {
              "id": "gate-test-mode-or-enabled",
              "leftValue": "={{ $env.TELEGRAM_TEST_MODE === 'true' ? ($env.TELEGRAM_ALLOWED_TEST_CHAT_IDS || '').split(',').map(id => id.trim()).includes(String($('Normalize Business Message').item.json.chat_id)) : ($json.is_enabled === true) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000006",
      "name": "Safety & Authorization Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO telegram_processed_updates (update_id, business_connection_id, chat_id, message_id)\nVALUES ({{ $('Normalize Business Message').item.json.update_id }}, '{{ $('Normalize Business Message').item.json.business_connection_id }}', {{ $('Normalize Business Message').item.json.chat_id }}, {{ $('Normalize Business Message').item.json.message_id }})\nON CONFLICT (update_id) DO NOTHING\nRETURNING update_id;",
        "options": {}
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000007",
      "name": "Atomic Deduplication Check",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1560, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-sales-agent",
          "name": "PostgreSQL Sales Agent"
        }
      }
    },
    {
      "parameters": {
        "workflowId": "0cGbWSPG0Z14h3So",
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "query": "={{ $('Normalize Business Message').item.json.text }}"
          }
        }
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000008",
      "name": "Retrieve Grounded Knowledge",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "workflowId": "wMZ3vsdPji1oSAr0",
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "query": "={{ $('Normalize Business Message').item.json.text }}",
            "customer_name": "={{ $('Normalize Business Message').item.json.sender_name }}",
            "knowledge": "={{ $json }}"
          }
        }
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000009",
      "name": "Generate Gemini Customer Reply",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"business_connection_id\": \"{{ $('Normalize Business Message').item.json.business_connection_id }}\",\n  \"chat_id\": {{ $('Normalize Business Message').item.json.chat_id }},\n  \"text\": {{ JSON.stringify($json.reply_text) }}\n}",
        "options": {}
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000010",
      "name": "Send Reply on Behalf of Seller",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 200],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO telegram_business_connections (business_connection_id, user_id, user_chat_id, can_reply, is_enabled, updated_at)\nVALUES ('{{ $json.body.business_connection.id }}', {{ $json.body.business_connection.user.id }}, {{ $json.body.business_connection.user_chat_id }}, {{ $json.body.business_connection.can_reply }}, {{ $json.body.business_connection.is_enabled }}, NOW())\nON CONFLICT (business_connection_id) DO UPDATE SET\n  can_reply = EXCLUDED.can_reply,\n  is_enabled = EXCLUDED.is_enabled,\n  updated_at = NOW()\nRETURNING business_connection_id;",
        "options": {}
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000011",
      "name": "Record Connection Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [900, 380],
      "credentials": {
        "postgres": {
          "id": "postgres-sales-agent",
          "name": "PostgreSQL Sales Agent"
        }
      }
    },
    {
      "parameters": {
        "workflowId": "GzGhjXdy38xmzByE",
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "command": "={{ $json.body.message.text }}",
            "sender_id": "={{ $json.body.message.from.id }}",
            "chat_id": "={{ $json.body.message.chat.id }}"
          }
        }
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000012",
      "name": "Execute Owner Control Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [900, 520]
    }
  ],
