        "query": "=INSERT INTO chat_conversation_state (chat_id, is_paused, last_message_from, pause_reason, updated_at)\nVALUES ({{ $('Normalize Business Message').item.json.chat_id }}, true, 'seller', 'Human takeover: seller replied in customer DM', NOW())\nON CONFLICT (chat_id) DO UPDATE SET\n  is_paused = true,\n  last_message_from = 'seller',\n  pause_reason = 'Human takeover: seller replied in customer DM',\n  updated_at = NOW()\nRETURNING chat_id, is_paused;",
        "options": {}
