    {
      "parameters": {
        "jsCode": "const invItems = $('Fetch Product Inventory Sheet').all();\nconst ratesItems = $('Fetch Shipping & Packing Rates Sheet').all();\nconst payItems = $('Fetch Payment Methods Sheet').all();\n\n// Check if API call failed\nconst firstInv = invItems[0]?.json || {};\nif (firstInv.error) {\n  return {\n    status: 'FAILED',\n    error: firstInv.error.message || 'Google Sheets API authentication or connection failure',\n    productsCount: 0\n  };\n}\n\n// Parse Products\nlet parsedProducts = [];\nlet idCounter = 1;\nfor (const item of invItems) {\n  const row = item.json;\n  const member = (row.Member || row.member || '').trim();\n  const productName = (row['Product Name'] || row.product_name || row['Item Name'] || '').trim();\n  const rawPrice = row.Price || row['Price (PHP)'] || row.price || '0';\n  const rawStock = row.Stock || row.Quantity || row.stock || '0';\n  const notes = (row['Condition / Notes'] || row.Notes || row.notes || '').trim();\n\n  if (member && productName) {\n    const price = parseInt(String(rawPrice).replace(/[^0-9]/g, ''), 10) || 0;\n    const stock = parseInt(String(rawStock).replace(/[^0-9]/g, ''), 10) || 0;\n    parsedProducts.push({\n      id: idCounter++,\n      member: member.toUpperCase(),\n      product_name: productName,\n      price_php: price,\n      stock,\n      notes,\n      keywords: `${member} ${productName} ${notes}`.toLowerCase()\n    });\n  }\n}\n\nreturn {\n  status: 'SUCCESS',\n  productsCount: parsedProducts.length,\n  products: parsedProducts\n};"
      },
