# Sensitive knowledge base data and customer payment information
data/knowledge_base.json
data/*.json
!data/knowledge_base.example.json
!data/.gitkeep

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.production.example

# Local persistent data directories (if any bind mounts are used)
n8n_data/
postgres_data/

# Local backups and dumps (keep folder tracked via .gitkeep)
backups/*.sql
backups/*.tar
backups/*.tar.gz
backups/*.dump
!backups/.gitkeep
workflows/workflows_*.json

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
tmp/
