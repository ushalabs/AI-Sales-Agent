# ==============================================================================
# AI SALES AGENT - PRODUCTION CONFIGURATION TEMPLATE (ORACLE CLOUD ARM64)
# ==============================================================================
# Copy this file to .env.production on your Oracle Cloud VM:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# NEVER commit .env.production or any file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# DOMAIN & PUBLIC WEBHOOK
# ------------------------------------------------------------------------------
# The fully-qualified domain name pointing to your Oracle Cloud VM's public IP
# Example: agent.yourdomain.com
DOMAIN_NAME=agent.yourdomain.com

# ------------------------------------------------------------------------------
# POSTGRESQL PRODUCTION DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL container image tag (multi-arch, ARM64 compatible)
POSTGRES_IMAGE_TAG=16-alpine

# Database name
POSTGRES_DB=n8n_sales_agent

# Database username
POSTGRES_USER=n8n_db_user

# Generate a strong 32+ character random password:
# openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD_MIN_32_CHARS

# ------------------------------------------------------------------------------
# N8N SETTINGS & ENCRYPTION
# ------------------------------------------------------------------------------
# n8n container image tag (multi-arch, ARM64 compatible)
N8N_IMAGE_TAG=2.44.6

# Generate a strong 32+ byte hex key (CRITICAL: Back this up safely; losing it prevents decrypting credentials):
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_N8N_ENCRYPTION_KEY_HEX_32_BYTES

# Business Timezone
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# ------------------------------------------------------------------------------
# TELEGRAM BUSINESS INTEGRATION
# ------------------------------------------------------------------------------
# Bot token from @BotFather (keep secret)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER

# Secret token for X-Telegram-Bot-Api-Secret-Token webhook authentication (1-256 chars, A-Za-z0-9_-)
# openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_SECRET_WEBHOOK_TOKEN_32_HEX

# The seller's personal Telegram User ID (digits only, e.g. 123456789)
TELEGRAM_SELLER_USER_ID=YOUR_TELEGRAM_USER_ID

# Set to true during initial testing to limit automated replies to allowed test accounts
# Set to false once verified to enable production customer handling
TELEGRAM_TEST_MODE=true

# Comma-separated list of Telegram Chat IDs allowed to receive automated replies when TEST_MODE=true
TELEGRAM_ALLOWED_TEST_CHAT_IDS=YOUR_TELEGRAM_USER_ID

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI MODEL
# ------------------------------------------------------------------------------
# Gemini API Key from Google AI Studio (keep secret)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model identifier
GEMINI_MODEL=gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# GOOGLE SHEETS OAUTH (OPTIONAL - IF CONNECTING LIVE SPREADSHEET IN n8n)
# ------------------------------------------------------------------------------
# Set up in Google Cloud Console with Redirect URI:
# https://${DOMAIN_NAME}/rest/oauth2-credential/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
